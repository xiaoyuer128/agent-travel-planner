# 默认 Mock；真实问答、行程及JSON费用估算使用 deepseek，填写自己的密钥并重启
# AI费用估算无需额外航班/酒店API Key，金额仅用于规划参考
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# 高德 Web 服务密钥，仅后端使用
AMAP_API_KEY=

API_HOST=127.0.0.1
API_PORT=18000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
COOKIE_SECURE=false
ADMIN_EMAILS=
# 可选：自定义数据库绝对路径；图片位于相邻 uploads 目录
# CHAT_DB_PATH=

RAG_EMBEDDING=mock
RAG_STORE=memory
RAG_TOP_K=3
BUDGET_MAX_RETRIES=3
PARALLEL_TIMEOUT=30
