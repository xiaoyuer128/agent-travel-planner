# LLM 配置
# 默认 mock 模式：零成本运行，不调用真实 API
# 接入真实 LLM：把 LLM_PROVIDER 改成 deepseek（或 openai/minimax），并填入 LLM_API_KEY
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096


# 预算循环最大重试次数
BUDGET_MAX_RETRIES=3

# 并行 Agent 超时（秒）
PARALLEL_TIMEOUT=30

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
